# Copy this file to .env and fill in the URL where you're running artifacts/api-server.
# This is safe to be public — it's just a URL, not a secret. The actual
# OpenRouter/Gemini API keys live only on the server (see artifacts/api-server/.env.example).

# Example: EXPO_PUBLIC_API_BASE_URL=https://your-api-server.example.com
# Leave blank to run with Tier 1 (on-device parsing) only — Tier 2/3 and the
# Gemini audit will gracefully report "not configured" instead of failing.
EXPO_PUBLIC_API_BASE_URL=
