# Copy this file to .env and fill in real values.
# NONE of these should ever be prefixed with EXPO_PUBLIC_ or shipped to the app —
# they must only exist here, on the server.

# Required to start the server
PORT=3000

# Optional — Tier 2 (OpenRouter / Llama 3.3 70B) fast AI parsing.
# If unset, /api/parse returns 503 and the app falls back to its offline sync queue.
OPENROUTER_API_KEY=

# Optional — Tier 3 (Google Gemini 2.5 Flash) deep financial audit.
# If unset, /api/audit returns 503 and the app shows "Tier 3 not configured".
GEMINI_API_KEY=
