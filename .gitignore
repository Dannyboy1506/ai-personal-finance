# Dependencies
node_modules/
.pnpm-store/

# Environment files — NEVER commit real secrets.
# .env.example files are intentionally kept (see git-tracked entries below).
.env
.env.local
.env.*.local
artifacts/*/.env
artifacts/*/.env.local
!**/.env.example

# Expo / React Native
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native projects generated by `expo prebuild` — this repo uses the managed
# workflow, so these are regenerated fresh by the GitHub Actions build rather
# than committed. Delete this block if you intentionally check native
# projects in later.
artifacts/fintech-app/android/
artifacts/fintech-app/ios/

# Build output
build/
*.tsbuildinfo

# Logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Testing
coverage/
